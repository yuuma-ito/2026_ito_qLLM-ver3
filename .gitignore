.env
.venv/
results/**/raw.jsonl
logs/
.cache/
# results/ は基本無視するが、共有する実験データ(jsonl)と集計/診断レポート(md)は追跡する。
# mock 等の使い捨ては引き続き無視。
results/*
!results/*.jsonl
!results/*.md
results/mock*.jsonl
__pycache__/
*.pyc
.pytest_cache/
*:Zone.Identifier
# 発表資料作成の中間ファイル。共有用PDF・原稿・検証結果は追跡する。
docs/completion_drafts/**/paper.aux
docs/completion_drafts/**/paper.dvi
docs/completion_drafts/**/paper.log
docs/completion_drafts/**/build_*.txt
docs/completion_drafts/**/paper_extracted.txt
docs/completion_drafts/**/pdffonts.txt
docs/completion_drafts/**/pdfinfo.txt
docs/completion_drafts/**/ai_response.json
docs/completion_drafts/**/response_schema.json
