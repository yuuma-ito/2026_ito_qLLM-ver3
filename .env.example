# Qiskit LLM Evaluation - API keys
# Copy this file to .env and fill in your keys.
# DO NOT commit .env

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Slackへのメール通知（無料プランのSlackbot転送先を指定）
# 実アドレス・パスワードは .env にのみ保存する。
SLACK_EMAIL_TO=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=

# 任意: Incoming Webhook方式（メール方式では不要）
SLACK_WEBHOOK_URL=

# 任意: Slack API方式（メール方式では不要）
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# --- ローカル LLM (任意) ---
# クラウド API 不要。ローカルサーバを立てて model_spec を ollama:/local: にするだけ。
# 既定値で動くので、ポートやキーを変えたいときだけ設定する。

# Ollama (`ollama serve`、既定: http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama

# 汎用 OpenAI 互換ローカルサーバ (vLLM / LM Studio / llama.cpp server など)
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# LOCAL_LLM_API_KEY=sk-no-key
