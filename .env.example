# Qiskit LLM Evaluation - API keys
# Copy this file to .env and fill in your keys.
# DO NOT commit .env

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- ローカル LLM (任意) ---
# クラウド API 不要。ローカルサーバを立てて model_spec を ollama:/local: にするだけ。
# 既定値で動くので、ポートやキーを変えたいときだけ設定する。

# Ollama (`ollama serve`、既定: http://localhost:11434/v1)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama

# 汎用 OpenAI 互換ローカルサーバ (vLLM / LM Studio / llama.cpp server など)
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1
# LOCAL_LLM_API_KEY=sk-no-key
