# Email experiment progress to Slackbot at 09:00 and 18:00 (Asia/Tokyo).
# Keep notifying when the experiment is stopped or completed.
# This host's system timezone must stay Asia/Tokyo; --timezone only formats messages.
# Credentials are loaded from the repository .env, never from this crontab.
0 9,18 * * * cd /home/23tc011/2026_ito_qLLM-ver3 && /home/23tc011/2026_ito_qLLM-ver3/.venv/bin/python -m scripts.notify_progress --config configs/shared_three_models_quick.json --latest --timezone Asia/Tokyo --transport email >> /home/23tc011/2026_ito_qLLM-ver3/logs/slack_progress.log 2>&1
# Observe every 5 minutes; alert once per event, never stop the experiment automatically.
*/5 * * * * cd /home/23tc011/2026_ito_qLLM-ver3 && /home/23tc011/2026_ito_qLLM-ver3/.venv/bin/python -m scripts.monitor_experiments --transport email --stalled-after 3600 >> /home/23tc011/2026_ito_qLLM-ver3/logs/experiment_monitor.log 2>&1
