# Email experiment progress to Slackbot every 3 hours at 00:00, 03:00, 06:00, 09:00, 12:00, 15:00, 18:00 and 21:00 (Asia/Tokyo).
# Skip periodic delivery without a live experiment; automatically resume at the next slot after a new run starts.
# This host's system timezone must stay Asia/Tokyo; --timezone only formats messages.
# Credentials are loaded from the repository .env, never from this crontab.
0 */3 * * * cd /home/23tc011/2026_ito_qLLM-ver3 && /home/23tc011/2026_ito_qLLM-ver3/.venv/bin/python -m scripts.notify_progress --overview --only-active --timezone Asia/Tokyo --transport email >> /home/23tc011/2026_ito_qLLM-ver3/logs/slack_progress.log 2>&1
# Observe every 5 minutes; report running experiments once per 3-hour slot.
# Alert once per completion/anomaly event; never stop the experiment automatically.
*/5 * * * * cd /home/23tc011/2026_ito_qLLM-ver3 && /home/23tc011/2026_ito_qLLM-ver3/.venv/bin/python -m scripts.monitor_experiments --transport email --stalled-after 3600 --progress-interval 10800 >> /home/23tc011/2026_ito_qLLM-ver3/logs/experiment_monitor.log 2>&1
# Refresh the local status index every 5 minutes; no model calls or notifications.
*/5 * * * * cd /home/23tc011/2026_ito_qLLM-ver3 && /home/23tc011/2026_ito_qLLM-ver3/.venv/bin/python -m scripts.research_status >> /home/23tc011/2026_ito_qLLM-ver3/logs/research_status.log 2>&1
# Refresh experiment provenance separately; this does not run experiments or verify claims.
*/5 * * * * cd /home/23tc011/2026_ito_qLLM-ver3 && /home/23tc011/2026_ito_qLLM-ver3/.venv/bin/python -m scripts.research_ledger >> /home/23tc011/2026_ito_qLLM-ver3/logs/research_ledger.log 2>&1
# Refresh report counts and tables hourly at minute 0, preserving manually written prose.
0 * * * * cd /home/23tc011/2026_ito_qLLM-ver3 && /home/23tc011/2026_ito_qLLM-ver3/.venv/bin/python -m scripts.update_experiment_report >> /home/23tc011/2026_ito_qLLM-ver3/logs/experiment_report_update.log 2>&1
# Start Codex once after this saved five-model run finishes; share its progress draft via email.
*/5 * * * * cd /home/23tc011/2026_ito_qLLM-ver3 && /home/23tc011/2026_ito_qLLM-ver3/.venv/bin/python -m scripts.draft_after_experiment --config results/shared_five_models_full_20261010T041019864060Z/experiment_config.json --codex /home/23tc011/.local/bin/codex --transport email >> /home/23tc011/2026_ito_qLLM-ver3/logs/draft_after_experiment.log 2>&1
